# DisasterGuard Frontend Environment Variables Template
VITE_API_BASE_URL=http://localhost:8080

# Paste your real Firebase Web App configuration from Firebase Console below:
VITE_FIREBASE_API_KEY=your_actual_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Generate VAPID Key from Firebase Console -> Project Settings -> Cloud Messaging -> Web Push Certificates:
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key_here
